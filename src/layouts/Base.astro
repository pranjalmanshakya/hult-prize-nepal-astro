---
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import '../styles/watermelon.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PageMeta } from '../data/pages';
import { org } from '../data/site';
import { backdropFor } from '../data/backdrops';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema, toJsonLd } from '../lib/schema';

interface Props {
  /** Title, description and path for this page (see src/data/pages.ts). */
  page: PageMeta;
  /** Keep the page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Extra structured-data nodes for this page, such as FAQPage. */
  schema?: Record<string, unknown>[];
}
const { page, noindex = false, schema = [] } = Astro.props;
const site = Astro.site!;
const canonical = new URL(page.path, site).href;
const shareImage = new URL(`/og/${page.slug}.png`, site).href;
const isHome = page.path === '/';
const hasBreadcrumb = !isHome && !noindex;
const graph = noindex
  ? [organizationSchema(site), websiteSchema(site)]
  : [
      organizationSchema(site),
      websiteSchema(site),
      webPageSchema(site, page, hasBreadcrumb),
      ...(hasBreadcrumb ? [breadcrumbSchema(site, page)] : []),
      ...schema,
    ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#150007" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${page.share.join(' ')}. ${org.alternateName}.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Lets the site run as an installed app on phones (see site.webmanifest and sw.js) -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={org.name} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" is:inline set:html={toJsonLd(graph)} />
  </head>
  <body>
    <!-- A blurred event photo behind the whole page (see src/data/backdrops.ts) -->
    <div class="backdrop" style={`--bg:url(${backdropFor(page.slug)})`} aria-hidden="true"></div>
    <div class="frame-lines" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <p class="net-status" id="net-status" role="status" hidden>You are offline. Saved pages still work.</p>
    <script>
      // ---- Installable app and offline reading ----
      if ('serviceWorker' in navigator) {
        // Only the built site registers the service worker. In local development it
        // would keep serving saved copies of files that are being edited.
        if (import.meta.env.PROD) addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
        else navigator.serviceWorker.getRegistrations().then((all) => all.forEach((r) => r.unregister()));
      }

      // Tell visitors when they have lost their connection.
      const net = document.getElementById('net-status');
      const showNet = () => { if (net) net.hidden = navigator.onLine; };
      addEventListener('online', showNet);
      addEventListener('offline', showNet);
      showNet();

      // "Install the app" button in the footer. Browsers that support installing
      // announce it with this event; the button stays hidden everywhere else.
      type InstallEvent = Event & { prompt: () => Promise<unknown> };
      const installBtn = document.getElementById('install-btn');
      let installEvent: InstallEvent | null = null;
      addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        installEvent = event as InstallEvent;
        if (installBtn) installBtn.hidden = false;
      });
      installBtn?.addEventListener('click', async () => {
        if (!installEvent) return;
        await installEvent.prompt();
        installEvent = null;
        installBtn.hidden = true;
      });
      addEventListener('appinstalled', () => { if (installBtn) installBtn.hidden = true; });
    </script>
    <script>
      // ---- Scroll reveals and count-up numbers (styles in motion.css) ----
      // Only items that start below the screen are hidden, and each is shown just
      // before it scrolls into view, so nothing on screen ever blinks or waits.
      const REVEAL = '.sec-head, .split > .stack, .card, .stat, .panel, .person, .champ, .timeline li, .steps li, .numbered li, .pipeline li, .link-card, .photo, .framed, .photo-row figure, .summit, .gallery button, .contact-card, .faq details, .dates > div, .benefit-list > div, .quote, .map, .cta-panel, .sdgs li, .ridge, .bento-card, .checks > li, .list > li, .chips > li, .event-days .day';
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);

      // Rolling-digit counter: each digit of a figure such as "550+" scrolls up into
      // place, like a mechanical counter. The real value stays readable for screen
      // readers, and the plain text is put back once the roll has finished.
      const roll = (el: HTMLElement) => {
        if (el.dataset.rolled) return;
        el.dataset.rolled = '1';
        const text = el.textContent ?? '';
        if (!/\d/.test(text)) return;
        let k = 0;
        const parts = [...text].map((ch) => {
          if (!/\d/.test(ch)) return '<span>' + ch + '</span>';
          const strip = Array.from({ length: 10 }, (_, d) => '<span>' + d + '</span>').join('');
          return '<span class="odo-d" style="--n:' + ch + ';--k:' + k++ + '"><span class="odo-s">' + strip + '</span></span>';
        });
        el.innerHTML = '<span class="sr-only">' + text + '</span><span class="odo" aria-hidden="true">' + parts.join('') + '</span>';
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('run')));
        setTimeout(() => { el.textContent = text; el.classList.remove('run'); }, 1700 + k * 90 + 300);
      };
      const countIn = (root: Element) => root.querySelectorAll<HTMLElement>('.stat b, .fact-band b').forEach(roll);

      if (!still) {
        // Figures already on screen count up straight away.
        document.querySelectorAll<HTMLElement>('.stat, .fact-band .wrap > div').forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) countIn(el);
        });
        // Lists already on screen when the page opens still come in one item at a time.
        document.querySelectorAll<HTMLElement>('.checks > li, .list > li, .chips > li').forEach((el) => {
          if (el.getBoundingClientRect().top > innerHeight) return;
          const index = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
          el.style.setProperty('--d', Math.min(index, 8) * 90 + 'ms');
          el.classList.add('pop');
        });
        const below = Array.from(document.querySelectorAll<HTMLElement>(REVEAL)).filter((el) => el.getBoundingClientRect().top > innerHeight);
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            io.unobserve(el);
            el.classList.add('in');
            countIn(el);
            // Once it has appeared, drop the reveal classes so the element's own hover effects apply again.
            setTimeout(() => el.classList.remove('pre', 'in'), 1300);
          }
        }, { rootMargin: '0px 0px 6% 0px' });
        for (const el of below) {
          // Siblings appear one after another.
          const index = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
          el.style.setProperty('--d', Math.min(index, 6) * (el.matches('li') ? 100 : 60) + 'ms');
          el.classList.add('pre');
          io.observe(el);
        }
        // A fast jump down the page (End key, scrollbar drag, a link to a section) can skip
        // past items without them ever crossing the screen. Show anything already above
        // the screen straight away, without animation.
        let ticking = false;
        addEventListener('scroll', () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            document.querySelectorAll<HTMLElement>('.pre:not(.in)').forEach((el) => {
              if (el.getBoundingClientRect().bottom > 0) return;
              io.unobserve(el);
              el.classList.remove('pre');
              countIn(el);
            });
          });
        }, { passive: true });
      }
    </script>
  </body>
</html>
