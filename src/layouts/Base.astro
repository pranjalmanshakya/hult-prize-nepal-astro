---
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import '../styles/motion.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PageMeta } from '../data/pages';
import { org } from '../data/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema, toJsonLd } from '../lib/schema';

interface Props {
  /** Title, description and path for this page (see src/data/pages.ts). */
  page: PageMeta;
  /** Keep the page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Extra structured-data nodes for this page, such as FAQPage. */
  schema?: Record<string, unknown>[];
}
const { page, noindex = false, schema = [] } = Astro.props;
const site = Astro.site!;
const canonical = new URL(page.path, site).href;
const shareImage = new URL(`/og/${page.slug}.png`, site).href;
const isHome = page.path === '/';
const hasBreadcrumb = !isHome && !noindex;
const graph = noindex
  ? [organizationSchema(site), websiteSchema(site)]
  : [
      organizationSchema(site),
      websiteSchema(site),
      webPageSchema(site, page, hasBreadcrumb),
      ...(hasBreadcrumb ? [breadcrumbSchema(site, page)] : []),
      ...schema,
    ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#150007" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${page.share.join(' ')}. ${org.alternateName}.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Lets the site run as an installed app on phones (see site.webmanifest and sw.js) -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={org.name} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <script type="application/ld+json" is:inline set:html={toJsonLd(graph)} />
    <!-- Marks the page as script-enabled before first paint, so scroll reveals never flash. If the main script has not started within 3.5 seconds, everything is shown. -->
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){if(!window.__reveal)document.documentElement.classList.remove('js')},3500);</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <p class="net-status" id="net-status" role="status" hidden>You are offline. Saved pages still work.</p>
    <script>
      // ---- Installable app and offline reading ----
      if ('serviceWorker' in navigator) {
        // Only the built site registers the service worker. In local development it
        // would keep serving saved copies of files that are being edited.
        if (import.meta.env.PROD) addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
        else navigator.serviceWorker.getRegistrations().then((all) => all.forEach((r) => r.unregister()));
      }

      // Tell visitors when they have lost their connection.
      const net = document.getElementById('net-status');
      const showNet = () => { if (net) net.hidden = navigator.onLine; };
      addEventListener('online', showNet);
      addEventListener('offline', showNet);
      showNet();

      // "Install the app" button in the footer. Browsers that support installing
      // announce it with this event; the button stays hidden everywhere else.
      type InstallEvent = Event & { prompt: () => Promise<unknown> };
      const installBtn = document.getElementById('install-btn');
      let installEvent: InstallEvent | null = null;
      addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        installEvent = event as InstallEvent;
        if (installBtn) installBtn.hidden = false;
      });
      installBtn?.addEventListener('click', async () => {
        if (!installEvent) return;
        await installEvent.prompt();
        installEvent = null;
        installBtn.hidden = true;
      });
      addEventListener('appinstalled', () => { if (installBtn) installBtn.hidden = true; });
    </script>
    <script>
      // Scroll reveals and count-up numbers. The selector list matches src/styles/motion.css.
      const REVEAL = '.sec-head, .split > .stack, .card, .stat, .panel, .person, .champ, .timeline li, .steps li, .numbered li, .pipeline li, .link-card, .photo, .framed, .photo-row figure, .summit, .gallery button, .contact-card, .faq details, .dates > div, .benefit-list > div, .quote, .map, .hero-facts .wrap > div, .cta-band .wrap > *, .ridge';
      const items = Array.from(document.querySelectorAll<HTMLElement>(REVEAL));
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);

      // Counts a figure such as "550+" or "2,200" up from zero. The real value is already in the HTML.
      const countUp = (el: HTMLElement) => {
        const m = (el.textContent ?? '').match(/^(\D*)(\d[\d,]*)(.*)$/);
        if (!m) return;
        const target = Number(m[2].replace(/,/g, ''));
        if (target < 10) return;
        const start = performance.now();
        const step = (now: number) => {
          const k = Math.min(1, (now - start) / 1500);
          const eased = 1 - Math.pow(1 - k, 4);
          el.textContent = m[1] + Math.round(target * eased).toLocaleString('en-US') + m[3];
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      if (still) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.unobserve(entry.target);
            reveal(entry.target as HTMLElement);
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
        const reveal = (el: HTMLElement) => {
          el.classList.add('in');
          if (el.matches('.stat, .hero-facts .wrap > div')) el.querySelectorAll<HTMLElement>('b').forEach(countUp);
        };
        for (const el of items) {
          // Siblings appear one after another.
          const index = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
          el.style.setProperty('--d', Math.min(index, 8) * 70 + 'ms');
          // Anything already on screen is shown straight away; the rest waits for scroll.
          if (el.getBoundingClientRect().top < innerHeight * 0.95) reveal(el);
          else io.observe(el);
        }
      }
      (window as unknown as { __reveal: boolean }).__reveal = true;
    </script>
  </body>
</html>
