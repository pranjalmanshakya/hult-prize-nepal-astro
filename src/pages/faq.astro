---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Explore from '../components/Explore.astro';
import { faqs, season } from '../data/site';
import { pages } from '../data/pages';
import { faqSchema } from '../lib/schema';
---
<Base page={pages.faq} schema={[faqSchema(Astro.site!, pages.faq, faqs)]}>
  <PageHero page={pages.faq} arch="volcano" kicker="Questions" lead="Short answers on cost, eligibility, teams and what happens after Nationals.">
    Frequently asked <em>questions</em>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="faq">
        {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
      <div class="panel soft" style="max-width:860px;margin-top:40px">
        <h2>Still have a question?</h2>
        <p class="muted">The full rules are published by the EF Hult Prize at <a class="text-link" href={season.official} target="_blank" rel="noopener">hultprize.org</a>. For anything about Nepal, the <a class="text-link" href={pages.contact.path}>national team</a> will help.</p>
      </div>
    </div>
  </section>

  <Explore keys={['compete', 'host', 'contact']} soft />
</Base>
