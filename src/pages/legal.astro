---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Explore from '../components/Explore.astro';
import { season, team } from '../data/site';
import { pages } from '../data/pages';
const ncc = team.find((p) => p.badge === 'NCC')!;
---
<Base page={pages.legal}>
  <PageHero page={pages.legal} kicker="Effective 20 October 2026 · Hult Prize Nepal">
    Privacy <em>&amp; Terms</em>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="prose">
        <h2 id="privacy">Privacy</h2>
        <p>This website gives information about the EF Hult Prize in Nepal. It has no accounts, forms, advertising, analytics or tracking cookies, and we do not collect personal information through it.</p>
        <ul>
          <li><b>Hosting.</b> The server that delivers this site may keep standard technical logs (such as IP address and browser type) for security. We do not use them to profile visitors.</li>
          <li><b>Fonts.</b> The typeface is served from this website itself. Loading a page does not contact any third-party font service.</li>
          <li><b>Offline copy.</b> Your browser saves a copy of this site's pages on your device so they open faster and can be read without a connection. The copy contains only the public pages, holds no information about you, and can be removed by clearing site data in your browser.</li>
          <li><b>Registration.</b> Competition registration happens on <a href={season.official} target="_blank" rel="noopener">hultprize.org</a>, under the EF Hult Prize's own privacy policy.</li>
          <li><b>Email.</b> If you email the national team, we use your message only to reply and to run the program.</li>
        </ul>
        <p>Under Nepal's Individual Privacy Act, 2075 (2018), you may ask what information we hold about you and ask us to correct or delete it. Contact the national team using the details on the <a href={pages.contact.path}>contact page</a>.</p>

        <h2 id="terms">Terms</h2>
        <ul>
          <li>Dates, rules and prizes may change. Official competition rules are those published by the EF Hult Prize at hultprize.org.</li>
          <li>Figures marked as Hult Prize Nepal figures come from our 2025–26 qualifiers report; global figures come from the EF Hult Prize 2026 season. See <a href={pages.sources.path}>sources and verification</a>.</li>
          <li>EF, EF Education First, Hult Prize, EF Hult Prize and their logos are trademarks of their owners and are used by Hult Prize Nepal as the national program of the EF Hult Prize.</li>
          <li>Photos are from Hult Prize Nepal and Hult Prize events. If you appear in a photo and would like it removed, contact us and we will remove it.</li>
        </ul>

        <h2 id="people">People named on this site</h2>
        <p>We name team members, campus winners, judges and guests only in their public roles. To correct or remove an entry, contact the national team.</p>

        <p class="box">Questions? Email the National Community Coordinator at <a href={`mailto:${ncc.email}`}>{ncc.email}</a> or message <a href={season.instagram} target="_blank" rel="noopener">@hultprizenepal</a>.</p>
      </div>
    </div>
  </section>

  <Explore keys={['sources', 'contact', 'about']} soft />
</Base>
