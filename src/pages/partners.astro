---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Explore from '../components/Explore.astro';
import { pastPartners, team } from '../data/site';
import { pages } from '../data/pages';
const nc = team[0];
const mail = `mailto:${nc.email}?subject=Partnering%20with%20Hult%20Prize%20Nepal`;
const why = [
  ['Diverse talent', 'Engage the brightest minds from 50+ colleges across Nepal.'],
  ['Brand visibility', '500+ media appearances across TV, print and digital.'],
  ['Startup ecosystem', 'Connect with 50+ startups and industry experts.'],
  ['Social impact', 'Support purpose-driven entrepreneurship aligned with the SDGs.'],
  ['Customer reach', 'Meet students and young entrepreneurs directly.'],
];
---
<Base page={pages.partners}>
  <PageHero page={pages.partners} kicker="Partner with us" lead="Join the organizations backing student founders from 50+ colleges across Nepal, from OnCampus Programs to the National Competition.">
    Back Nepal's <em>next founders</em>
    <Fragment slot="actions">
      <a class="btn btn-primary" href={mail}>Talk to us about partnering</a>
      <a class="btn btn-light" href={pages.nationals.path}>About Nationals 2027</a>
    </Fragment>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Why partner</span>
        <h2 class="h2">Five reasons organizations back us</h2>
      </div>
      <div class="grid g5">
        {why.map(([title, text]) => <article class="card"><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="sec soft">
    <div class="wrap split top">
      <div class="panel c-midnight">
        <h2>What partners get</h2>
        <ul class="list">
          <li>Brand visibility across OnCampus events, Nationals and social media</li>
          <li>A stall and product display at events</li>
          <li>Speaking slots and seats on the judging panel</li>
          <li>Early access to Nepal's most promising student talent</li>
          <li>Recognition in press coverage and post-event videos</li>
        </ul>
        <div class="btn-row"><a class="btn btn-primary" href={mail}>Email the National Coordinator</a></div>
      </div>
      <div class="stack">
        <span class="kicker">In good company</span>
        <h2 class="h2">Past national partners and supporters</h2>
        <ul class="chips">{pastPartners.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <Explore keys={['nationals', 'nepal', 'contact']} />
</Base>
