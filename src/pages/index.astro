---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { brand, photo } from '../lib/img';
import { season, champions, nepalStats, pastPartners } from '../data/site';
import { pages } from '../data/pages';

const latest = [...champions].sort((a, b) => b.y - a.y)[0];
// The headline is split into words so each can slide up in turn (motion.css).
const headline = [['Changing'], ['the'], ['world'], ['with'], ['social', 'em'], ['enterprise', 'em']];
// The three dates a visitor needs first.
const keyDates = [
  ['Qualifiers end', `Before ${season.qualifiersCloseLabel}`],
  ['Nepal Nationals', season.nationals],
  ['Global Finals', 'September 2027'],
];
// The fanned deck of photos under the hero: the season poster in the middle,
// event photos either side. --x, --y and --r place and tilt each card.
const deck = [
  { img: photo('g-trophy'), alt: 'OnCampus winners lifting the trophy', x: -480, y: 70, r: -13, z: 1 },
  { img: photo('event-hall'), alt: 'A full hall for an OnCampus session', x: -250, y: 26, r: -7, z: 2 },
  { img: photo('global-celebrate'), alt: 'Teams celebrating at a Hult Prize summit', x: 250, y: 26, r: 7, z: 2 },
  { img: photo('ef-hult-community'), alt: 'Hult Prize participants holding pink Hult Prize flags', x: 480, y: 70, r: 13, z: 1 },
];
---
<Base page={pages.home}>
  <section class="hero">
    <div class="wrap hero-center">
      <span class="badge-line">{season.name} season <i aria-hidden="true">—</i> Challenge: {season.challenge}</span>
      <h1>{headline.map(([word, em], i) => <><span class={em ? 'w em' : 'w'} style={`--i:${i}`}><span>{word}</span></span>{' '}</>)}</h1>
      <p class="lead">EF Hult Prize Nepal runs the world's largest student startup competition across Nepal. Win your campus, pitch at Nationals, and you could represent Nepal on the road to <b>US$1,000,000 in seed funding</b>.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={season.register} target="_blank" rel="noopener">Register your startup <span aria-hidden="true">↗</span></a>
        <a class="btn btn-line" href={pages.compete.path}>How to enter</a>
      </div>
      <dl class="key-chips">
        {keyDates.map(([what, when]) => <div><dt>{what}</dt><dd>{when}</dd></div>)}
      </dl>
    </div>
    <div class="deck">
      {deck.map((card, i) => (
        <div class="deck-card" style={`--x:${card.x}px;--y:${card.y}px;--r:${card.r}deg;--z:${card.z};--i:${i}`}>
          <Image src={card.img} alt={card.alt} widths={[300, 600]} sizes="300px" quality={90} loading="eager" />
        </div>
      ))}
      <div class="deck-card poster" style="--x:0px;--y:0px;--r:0deg;--z:3;--i:4">
        <Image src={brand('art-unlimited')} alt="Poster for the 2026–27 Hult Prize Challenge, Unlimited: pink and orange confetti on a deep purple background" widths={[280, 560, 840]} sizes="280px" quality={92} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="fact-band">
    <div class="wrap">
      <div><b>550+</b><span>startups registered in Nepal, 2025–26</span></div>
      <div><b>280+</b><span>OnCampus events</span></div>
      <div><b>45+</b><span>colleges at Nationals</span></div>
      <div><b>US$1M</b><span>for the global winner</span></div>
    </div>
  </div>

  <section class="sec">
    <div class="wrap split">
      <div class="photo wide">
        <Image src={photo('ef-hult-community')} alt="Hult Prize participants holding pink Hult Prize flags" widths={[560, 1120, 1400]} sizes="(max-width: 960px) 100vw, 560px" quality={90} />
      </div>
      <div class="stack">
        <span class="kicker">What is the EF Hult Prize?</span>
        <h2 class="h2">The “Nobel Prize” <em>for students</em></h2>
        <p class="lead">The EF Hult Prize is the world's largest student startup competition. It challenges university students to build financially sustainable startups that tackle the world's biggest problems, in line with the UN Sustainable Development Goals.</p>
        <p class="muted">Every September, one team wins US$1,000,000 in seed funding to launch its venture. Hult Prize Nepal runs the national program: OnCampus Programs at colleges across the country, and the National Competition whose winner represents Nepal.</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={pages.about.path}>About the prize</a>
          <a class="btn btn-line" href={pages.nepal.path}>Hult Prize in Nepal</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head center">
        <span class="kicker">This season</span>
        <h2 class="h2">Find your <em>way in</em></h2>
        <p class="lead">Whether you are a student with an idea, a college that wants to host, or an organization that wants to back student founders, start here.</p>
      </div>
      <div class="bento">
        <a class="bento-card b-wide" href={pages.challenge.path}>
          <span class="eyebrow">Challenge</span>
          <b>Unlimited: no single topic</b>
          <span>Pitch any for-profit startup with measurable social impact that serves at least one of the 17 UN Sustainable Development Goals.</span>
          <span class="decor arcs" aria-hidden="true"><em>17</em><small>SDGs</small></span>
        </a>
        <a class="bento-card" href={pages.compete.path}>
          <span class="eyebrow">Compete</span>
          <b>Five stages to the world</b>
          <span>{pages.compete.blurb}</span>
          <span class="decor stages" aria-hidden="true">{[1, 2, 3, 4, 5].map((n) => <i class={n === 1 ? 'on' : undefined}></i>)}<small>Stage 1 of 5: now</small></span>
        </a>
        <a class="bento-card" href={pages.nationals.path}>
          <span class="eyebrow">Nationals</span>
          <b>The National Competition</b>
          <span>{pages.nationals.blurb}</span>
          <span class="decor date" aria-hidden="true">Apr <em>2027</em></span>
        </a>
        <a class="bento-card" href={pages.campuses.path}>
          <span class="eyebrow">Campuses</span>
          <b>40+ OnCampus Programs</b>
          <span>{pages.campuses.blurb}</span>
          <span class="decor pixels" aria-hidden="true">{Array.from({ length: 48 }, (_, n) => <i class={n < 40 ? 'on' : undefined}></i>)}</span>
        </a>
        <a class="bento-card" href={pages.host.path}>
          <span class="eyebrow">Host a program</span>
          <b>Six steps to launch</b>
          <span>{pages.host.blurb}</span>
          <span class="decor meter" aria-hidden="true">{Array.from({ length: 24 }, (_, n) => <i style={`--n:${n}`}></i>)}</span>
        </a>
        <a class="bento-card b-full" href={pages.partners.path}>
          <span class="eyebrow">Partners</span>
          <b>Backed by organizations across Nepal</b>
          <span>{pages.partners.blurb}</span>
          <span class="marquee" aria-hidden="true">
            <span class="marquee-track">{[0, 1].map(() => pastPartners.map((p) => <span>{p}</span>))}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split top">
      <div class="stack">
        <span class="kicker">Made in Nepal</span>
        <h2 class="h2">{latest.team} won <em>Nationals {latest.y}</em></h2>
        <p class="lead">{latest.college}. {latest.text}</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={pages.champions.path}>Meet the champions</a>
          <a class="btn btn-line" href={pages.gallery.path}>See the photos</a>
        </div>
      </div>
      <div class="stack">
        <div class="stats three">
          {nepalStats.slice(0, 3).map((s) => <div class="stat"><b>{s.n}{s.suffix}</b><span>{s.label}</span></div>)}
        </div>
        <p class="small muted">Hult Prize Nepal qualifiers, 2025–26 season. <a class="text-link" href={pages.nepal.path}>See all the numbers and our story</a>.</p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // The site used to be one long page. Send old section links (/#team, /#faq …) to the new pages.
  const moved: Record<string, string> = {
    about: '/about/', challenge: '/challenge/', journey: '/compete/#journey', enter: '/compete/', nepal: '/nepal/', story: '/nepal/#story',
    team: '/team/', champions: '/champions/', campuses: '/campuses/', host: '/host/', nationals: '/nationals/', partner: '/partners/',
    gallery: '/gallery/', faq: '/faq/', contact: '/contact/', sources: '/sources/',
  };
  const target = moved[location.hash.slice(1)];
  if (target) location.replace(target);
</script>
