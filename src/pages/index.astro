---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Explore from '../components/Explore.astro';
import CtaBand from '../components/CtaBand.astro';
import { brand, photo } from '../lib/img';
import { season, champions, nepalStats } from '../data/site';
import { pages } from '../data/pages';

// The countdown is filled in at build time, then kept current in the browser.
const ms = Math.max(0, new Date(season.qualifiersClose).getTime() - Date.now());
const pad = (n: number) => String(n).padStart(2, '0');
const left = { d: String(Math.floor(ms / 864e5)), h: pad(Math.floor(ms / 36e5) % 24), m: pad(Math.floor(ms / 6e4) % 60), s: pad(Math.floor(ms / 1e3) % 60) };
const latest = [...champions].sort((a, b) => b.y - a.y)[0];
// The headline is split into words so each one can slide up in turn.
const headline = [['Changing'], ['the'], ['world'], ['with'], ['social', 'em'], ['enterprise', 'em']];
// Shown on a small glass card over the poster.
const keyDates = [
  [`Before ${season.qualifiersCloseLabel}`, 'Qualifier rounds end'],
  [season.nationals, 'Nepal National Competition'],
  ['September 2027', 'Global Finals for US$1,000,000'],
];
const ticker = ['EF Hult Prize Nepal', `Challenge: ${season.challenge}`, 'US$1,000,000 seed funding', 'OnCampus Programs', 'Nationals · April 2027', '17 SDGs', '550+ startups', 'Changing the world through social enterprise'];
---
<Base page={pages.home}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <ul class="tags">
          <li><span class="tag hot">{season.name} season</span></li>
          <li><span class="tag">Challenge: {season.challenge}</span></li>
          <li><span class="tag">Nationals: {season.nationals}</span></li>
        </ul>
        <h1>{headline.map(([word, em], i) => <><span class={em ? 'w em' : 'w'} style={`--i:${i}`}><span>{word}</span></span>{' '}</>)}</h1>
        <p class="lead">EF Hult Prize Nepal runs the world's largest student startup competition across Nepal. Build a startup that tackles a real problem, win your campus, pitch at Nationals, and you could represent Nepal on the road to <b>US$1,000,000 in seed funding</b>.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={season.register} target="_blank" rel="noopener">Register your startup <span aria-hidden="true">↗</span></a>
          <a class="btn btn-light" href={pages.compete.path}>How to enter</a>
          <a class="btn btn-light" href={pages.host.path}>Bring it to your campus</a>
        </div>
        <div class="countdown" id="countdown" data-deadline={season.qualifiersClose} hidden={ms === 0}>
          <div class="countdown-box"><b data-cd="d">{left.d}</b><span>Days</span></div>
          <div class="countdown-box"><b data-cd="h">{left.h}</b><span>Hours</span></div>
          <div class="countdown-box"><b data-cd="m">{left.m}</b><span>Min</span></div>
          <div class="countdown-box"><b data-cd="s">{left.s}</b><span>Sec</span></div>
          <p>left in the qualifier window. Qualifier rounds must be completed before {season.qualifiersCloseLabel}.</p>
        </div>
      </div>
      <div class="hero-visual">
      <div class="hero-art">
        <Image src={brand('art-unlimited')} alt="Poster for the 2026–27 Hult Prize Challenge, Unlimited: pink and orange confetti on a deep purple background" widths={[360, 565]} sizes="(max-width: 960px) 360px, 400px" loading="eager" fetchpriority="high" />
      </div>
        <div class="hero-note">
          <span class="kicker">Key dates</span>
          <dl>{keyDates.map(([when, what]) => <div><dt>{when}</dt><dd>{what}</dd></div>)}</dl>
        </div>
      </div>
    </div>
    <div class="hero-facts">
      <div class="wrap">
        <div><b>550+</b><span>startups registered in Nepal, 2025–26</span></div>
        <div><b>280+</b><span>OnCampus events</span></div>
        <div><b>45+</b><span>colleges at Nationals</span></div>
        <div><b>US$1M</b><span>for the global winner</span></div>
      </div>
    </div>
  </section>
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">{[0, 1].map(() => ticker.map((t) => <span>{t}</span>))}</div>
  </div>

  <section class="sec">
    <div class="wrap split">
      <div class="photo wide">
        <Image src={photo('ef-hult-community')} alt="Hult Prize participants holding pink Hult Prize flags" widths={[560, 1120]} sizes="(max-width: 960px) 100vw, 560px" />
      </div>
      <div class="stack">
        <span class="kicker">What is the EF Hult Prize?</span>
        <h2 class="h2">The “Nobel Prize” for students</h2>
        <p class="lead">The EF Hult Prize is the world's largest student startup competition. It challenges university students to build financially sustainable startups that tackle the world's biggest problems, in line with the UN Sustainable Development Goals.</p>
        <p class="muted">Every September, one team wins US$1,000,000 in seed funding to launch its venture. Hult Prize Nepal runs the national program: OnCampus Programs at colleges across the country, and the National Competition whose winner represents Nepal.</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={pages.about.path}>About the prize</a>
          <a class="btn btn-line" href={pages.nepal.path}>Hult Prize in Nepal</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec soft">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">This season</span>
        <h2 class="h2">Find your way in</h2>
        <p class="lead">Whether you are a student with an idea, a college that wants to host, or an organization that wants to back student founders, start here.</p>
      </div>
      <div class="explore">
        {(['challenge', 'compete', 'nationals', 'campuses', 'host', 'partners'] as const).map((key) => (
          <a class="link-card" href={pages[key].path}><b>{pages[key].label}</b><span>{pages[key].blurb}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split top">
      <div class="stack">
        <span class="kicker">Made in Nepal</span>
        <h2 class="h2">{latest.team} won Nationals in {latest.y}</h2>
        <p class="lead">{latest.college}. {latest.text}</p>
        <div class="btn-row">
          <a class="btn btn-dark" href={pages.champions.path}>Meet the champions</a>
          <a class="btn btn-line" href={pages.gallery.path}>See the photos</a>
        </div>
      </div>
      <div class="stack">
        <div class="stats three">
          {nepalStats.slice(0, 3).map((s, i) => (
            <div class={`stat ${['c-heritage', 'c-midnight', 'c-sun'][i]}`}><b>{s.n}{s.suffix}</b><span>{s.label}</span></div>
          ))}
        </div>
        <p class="small muted">Hult Prize Nepal qualifiers, 2025–26 season. <a class="text-link" href={pages.nepal.path}>See all the numbers and our story</a>.</p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Keep the qualifier countdown current.
  const cd = document.getElementById('countdown');
  if (cd) {
    const end = new Date(cd.dataset.deadline!).getTime();
    const pad = (n: number) => String(n).padStart(2, '0');
    // A number that changes drops in (see .tick in motion.css).
    const set = (k: string, v: string) => {
      const el = cd.querySelector<HTMLElement>(`[data-cd="${k}"]`);
      if (!el || el.textContent === v) return;
      el.textContent = v;
      el.classList.remove('tick');
      void el.offsetWidth;
      el.classList.add('tick');
    };
    const tick = () => {
      const ms = end - Date.now();
      if (ms <= 0) { cd.hidden = true; return; }
      set('d', String(Math.floor(ms / 864e5)));
      set('h', pad(Math.floor(ms / 36e5) % 24));
      set('m', pad(Math.floor(ms / 6e4) % 60));
      set('s', pad(Math.floor(ms / 1e3) % 60));
    };
    tick();
    setInterval(tick, 1000);
  }

  // The site used to be one long page. Send old section links (/#team, /#faq …) to the new pages.
  const moved: Record<string, string> = {
    about: '/about/', challenge: '/challenge/', journey: '/compete/#journey', enter: '/compete/', nepal: '/nepal/', story: '/nepal/#story',
    team: '/team/', champions: '/champions/', campuses: '/campuses/', host: '/host/', nationals: '/nationals/', partner: '/partners/',
    gallery: '/gallery/', faq: '/faq/', contact: '/contact/', sources: '/sources/',
  };
  const target = moved[location.hash.slice(1)];
  if (target) location.replace(target);
</script>
