---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Explore from '../components/Explore.astro';
import { photo } from '../lib/img';
import { team, pastLeadership } from '../data/site';
import { pages } from '../data/pages';
import { gmailCompose } from '../lib/mail';
import { teamSchema } from '../lib/schema';
const roles = [
  ['National Coordinator', 'Leads Hult Prize in Nepal and the National Competition.'],
  ['Deputy National Coordinator', 'Supports the National Coordinator across the season.'],
  ['National Community Coordinator', 'Keeps Campus Directors connected, onboarded and supported, and runs community events across the country.'],
];
---
<Base page={pages.team} schema={teamSchema(Astro.site!)}>
  <PageHero page={pages.team} arch="cotton" kicker="The people behind it" lead="Leading Hult Prize Nepal through the 2026–27 Unlimited season.">
    Meet the <em>2027 national team</em>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      <div class="people">
        {team.map((p) => (
          <article class="person">
            <Image src={photo(p.photo)} alt={p.alt} widths={[380, 640]} sizes="(max-width: 640px) 100vw, 360px" loading="eager" />
            <div class="info">
              <span class="role">{p.role}</span>
              <h2 class="h3">{p.name}</h2>
              <a href={gmailCompose(p.email)} target="_blank" rel="noopener">{p.email}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec soft">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">How it works</span>
        <h2 class="h2">Who does what</h2>
      </div>
      <div class="grid g3">
        {roles.map(([role, text]) => <article class="card"><h3>{role}</h3><p>{text}</p></article>)}
      </div>
      <p class="muted" style="margin-top:24px">Looking for the right person to talk to? Everyone's email is on the <a class="text-link" href={pages.contact.path}>contact page</a>.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Before this season</span>
        <h2 class="h2">Previous national leadership</h2>
        <p class="lead">Every past leader is on the <a class="text-link" href={pages.awards.path}>awards and honours</a> page, with the awards and nominations they received.</p>
      </div>
      <div class="grid g2">
        {pastLeadership.map((s) => (
          <article class="card">
            <span class="eyebrow">{s.season}</span>
            <ul class="list" style="list-style:none;padding:0">
              {s.people.map(([name, role]) => <li><b>{name}</b>, <span class="muted">{role}</span></li>)}
            </ul>
            <p>{s.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Explore keys={['awards', 'contact', 'champions']} soft />
</Base>
